/target-arm/
/.preloop/
/.runner-watch/repos/
/.runner-watch/**/*.pid
/.runner-watch/conformance/
# Conformance goldens: keep the replayable flows.jsonl fixtures in git so CI can
# run `runner-watch conform`, but drop the heavy raw captures and binary bodies.
/.runner-watch/golden/**/*.mitm
/.runner-watch/golden/**/*.bin
*.db
*.sqlite
*.log
.DS_Store

experiments/mitm/.cache/
experiments/mitm/captures/
experiments/mitm/reports/
experiments/mitm/golden/
__pycache__/

# Credentials & Local Environment
.env
*.pem
*.key
*.p12
*.cer
/_work/
/_runner_work/
/externals/
/.runner
/.credentials
/.credentials_rsaparams
/.aksh/
/.omp/
/.mcp/


# Local toolchains & runner binaries
.cargo/
.rustup/
actions-runner/
official-runner.tar.gz

# Large binary artifacts — never track
bin-linux/
libs/*.so*
benchmarks/real-world/aksh-runner
benchmarks/real-world/aksh-runner-new
benchmarks/real-world/official-runner.tar.gz
/benchmarks/compatibility/runner/protocol/
/benchmarks/compatibility/runner/protocol-local/
benchmarks/compatibility/server/protocol/captures/**/flow.*.bin

# Disposable official-runner installations used by smolVM comparisons.
/.runner-e2e/
/.runner-mount/

# Large live-comparison byproducts. Keep compact summaries, reports, and
# protocol metadata; discard runner diagnostics, workspaces, and payloads.
/benchmarks/compatibility/server/behavior/.payloads/
/benchmarks/compatibility/server/behavior/**/diag/
/benchmarks/compatibility/server/behavior/**/work/
/benchmarks/compatibility/server/behavior/**/blocks/
/benchmarks/compatibility/server/behavior/**/pages/
/benchmarks/compatibility/server/behavior/**/config-*.log
/benchmarks/compatibility/server/behavior/**/runner-*.log
/benchmarks/compatibility/server/behavior/**/official-runner.log
/benchmarks/compatibility/server/behavior/**/server.log
/benchmarks/compatibility/server/protocol/captures/**/flows.jsonl
/benchmarks/compatibility/server/protocol/captures/**/mitm.log
# Benchmark capture artifacts — keep metadata (summary.json, jobs.json, github-run-id.txt)
# but drop large flows, runner logs, certs, and per-runner capture dirs.
benchmarks/real-world/results/**/flows.jsonl
benchmarks/real-world/results/**/vm-mitm/
benchmarks/real-world/results/**/vm-mitm-conf/
benchmarks/real-world/results/**/vm-runner*.log
benchmarks/real-world/results/**/runner-*/
benchmarks/preloop-perf/results/
*.smolmachine
rust_out
/goal
