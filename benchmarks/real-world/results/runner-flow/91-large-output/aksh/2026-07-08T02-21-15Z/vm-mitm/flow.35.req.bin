2026-07-08T02:21:38.290Z ##[group]Run OUTPUT=''
2026-07-08T02:21:38.290Z OUTPUT=''
2026-07-08T02:21:38.290Z OUTPUT_SIZE=${#OUTPUT}
2026-07-08T02:21:38.290Z 
2026-07-08T02:21:38.290Z echo "Retrieved output variable size: $OUTPUT_SIZE bytes"
2026-07-08T02:21:38.290Z 
2026-07-08T02:21:38.290Z if [[ $OUTPUT_SIZE -gt 40000 ]]; then
2026-07-08T02:21:38.290Z   echo "✓ Large output variable (50KB+) retrieved successfully"
2026-07-08T02:21:38.290Z else
2026-07-08T02:21:38.290Z   echo "⚠ Output variable size smaller than expected: $OUTPUT_SIZE bytes"
2026-07-08T02:21:38.290Z fi
2026-07-08T02:21:38.290Z 
2026-07-08T02:21:38.290Z # Verify content integrity
2026-07-08T02:21:38.290Z if [[ "$OUTPUT" == *"Line 1"* ]] && [[ "$OUTPUT" == *"Line 1000"* ]]; then
2026-07-08T02:21:38.291Z   echo "✓ Large output variable content verified"
2026-07-08T02:21:38.291Z else
2026-07-08T02:21:38.291Z   echo "✗ Large output variable content corrupted"
2026-07-08T02:21:38.291Z fi
2026-07-08T02:21:38.291Z shell: bash --noprofile --norc -e -o pipefail {0}
2026-07-08T02:21:38.291Z ##[endgroup]
