2026-07-08T02:13:32.405Z ##[group]Run EMPTY_VAR=""
2026-07-08T02:13:32.405Z EMPTY_VAR=""
2026-07-08T02:13:32.405Z DEFAULT_VALUE="${EMPTY_VAR:-default}"
2026-07-08T02:13:32.405Z 
2026-07-08T02:13:32.405Z if [[ "$DEFAULT_VALUE" == "default" ]]; then
2026-07-08T02:13:32.405Z   echo "✓ Default value expansion works with empty var"
2026-07-08T02:13:32.406Z else
2026-07-08T02:13:32.406Z   echo "✗ Default value not applied: '$DEFAULT_VALUE'"
2026-07-08T02:13:32.406Z   exit 1
2026-07-08T02:13:32.406Z fi
2026-07-08T02:13:32.406Z ##[endgroup]
