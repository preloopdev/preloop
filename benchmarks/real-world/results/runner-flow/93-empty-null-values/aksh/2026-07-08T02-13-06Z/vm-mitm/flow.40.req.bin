2026-07-08T02:13:31.661Z ##[group]Run # Simulate matrix with empty value
2026-07-08T02:13:31.661Z # Simulate matrix with empty value
2026-07-08T02:13:31.661Z MATRIX_VALUES=("value1" "" "value3")
2026-07-08T02:13:31.661Z 
2026-07-08T02:13:31.661Z for i in "${!MATRIX_VALUES[@]}"; do
2026-07-08T02:13:31.662Z   VAL="${MATRIX_VALUES[$i]}"
2026-07-08T02:13:31.662Z   if [[ -z "$VAL" ]]; then
2026-07-08T02:13:31.662Z     echo "✓ Empty value in array index $i correctly identified"
2026-07-08T02:13:31.662Z   fi
2026-07-08T02:13:31.662Z done
2026-07-08T02:13:31.662Z ##[endgroup]
2026-07-08T02:13:31.665Z ✓ Empty value in array index 1 correctly identified
