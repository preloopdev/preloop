2026-07-08T02:13:30.639Z ##[group]Run # Unset env var should be empty/null
2026-07-08T02:13:30.640Z # Unset env var should be empty/null
2026-07-08T02:13:30.640Z UNSET_VAR="${NONEXISTENT_VAR}"
