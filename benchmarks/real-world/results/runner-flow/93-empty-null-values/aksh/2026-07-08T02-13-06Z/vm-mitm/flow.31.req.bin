2026-07-08T02:13:30.641Z fi
2026-07-08T02:13:30.642Z 
2026-07-08T02:13:30.642Z # Test in conditional
2026-07-08T02:13:30.642Z if [[ "$NONEXISTENT_VAR" == "" ]]; then
2026-07-08T02:13:30.642Z   echo "✓ Unset var comparison works"
2026-07-08T02:13:30.642Z else
2026-07-08T02:13:30.642Z   echo "✗ Unset var comparison failed"
