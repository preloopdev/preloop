2026-07-08T02:21:07.782Z ##[group]Run # Simulate matrix with empty value
2026-07-08T02:21:07.783Z # Simulate matrix with empty value
2026-07-08T02:21:07.783Z MATRIX_VALUES=("value1" "" "value3")
2026-07-08T02:21:07.783Z 
2026-07-08T02:21:07.783Z for i in "${!MATRIX_VALUES[@]}"; do
2026-07-08T02:21:07.783Z   VAL="${MATRIX_VALUES[$i]}"
2026-07-08T02:21:07.783Z   if [[ -z "$VAL" ]]; then
2026-07-08T02:21:07.783Z     echo "✓ Empty value in array index $i correctly identified"
2026-07-08T02:21:07.783Z   fi
2026-07-08T02:21:07.784Z done
2026-07-08T02:21:07.784Z shell: bash --noprofile --norc -e -o pipefail {0}
2026-07-08T02:21:07.784Z ##[endgroup]
2026-07-08T02:21:07.787Z ✓ Empty value in array index 1 correctly identified
