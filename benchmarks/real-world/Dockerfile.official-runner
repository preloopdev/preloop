FROM ubuntu:26.04@sha256:f144425ff09be612d6d9ad965196e9cdc23dae1f42110a8a11a3e9a8198759f7

RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends \
     git curl ca-certificates nodejs npm build-essential pkg-config libssl-dev \
    && install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) stable" > /etc/apt/sources.list.d/docker.list && \
    apt-get update -qq && \
    apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin && \
    rm -rf /var/lib/apt/lists/*

# Rust stable toolchain
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable 2>/dev/null && \
   /root/.cargo/bin/rustup component add rustfmt clippy && \
   curl -sSL https://github.com/Boshen/cargo-shear/releases/download/v1.12.4/cargo-shear-aarch64-unknown-linux-musl.tar.gz 2>/dev/null | tar -xz -C /root/.cargo/bin/ 2>/dev/null || true

ENV PATH="/root/.cargo/bin:${PATH}"

# Official C# runner (needs non-root user)
COPY actions-runner /opt/actions-runner
RUN useradd -m -s /bin/bash runner && \
    chown -R runner:runner /opt/actions-runner
