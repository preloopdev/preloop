digraph control {
  graph [rankdir=TB, bgcolor="white", splines=spline, nodesep=0.3, ranksep=1.1, fontname="Helvetica", compound=true, newrank=true];
  node [shape=plain, fontname="Helvetica"];
  edge [color="#94a3b8", arrowsize=0.7];
  subgraph cluster_meta {
    label="Boot invariants"; fontsize=14; fontname="Helvetica"; fontcolor="#0f766e"; style="rounded,dashed"; color="#0f766e"; margin=16;
