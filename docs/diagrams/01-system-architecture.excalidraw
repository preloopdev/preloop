    {"type":"text","id":"panel_azdo_routes","x":552,"y":308,"width":440,"height":290,
     "text":"POST  /api/v3/actions/runner-registration\nGET   /_apis/distributedtask/pools\nPOST  /pools/:id/agents   (RSA key)\nPOST  /pools/:id/sessions (AES key)\nGET   /pools/:id/messages  waitSeconds=50\nDELETE /pools/:id/messages/:id  (ack)\nPOST  /_apis/v1/AgentRequest/:pool/:req\nPATCH /_apis/v1/AgentRequest/:pool/:req\nPOST  /broker/:id/acquirejob\nPOST  /broker/:id/renewjob\nPOST  /broker/:id/completejob\nPATCH /_apis/v1/Timeline/...\nPOST  /_apis/v1/Logfiles/...\nPOST  /_apis/v1/FinishJob/...\nGET   .../oidctoken?audience=...",
     "originalText":"POST  /api/v3/actions/runner-registration\nGET   /_apis/distributedtask/pools\nPOST  /pools/:id/agents   (RSA key)\nPOST  /pools/:id/sessions (AES key)\nGET   /pools/:id/messages  waitSeconds=50\nDELETE /pools/:id/messages/:id  (ack)\nPOST  /_apis/v1/AgentRequest/:pool/:req\nPATCH /_apis/v1/AgentRequest/:pool/:req\nPOST  /broker/:id/acquirejob\nPOST  /broker/:id/renewjob\nPOST  /broker/:id/completejob\nPATCH /_apis/v1/Timeline/...\nPOST  /_apis/v1/Logfiles/...\nPOST  /_apis/v1/FinishJob/...\nGET   .../oidctoken?audience=...",
