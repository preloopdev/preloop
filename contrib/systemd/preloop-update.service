[Unit]
# Managed copy: `preloop server install` renders equivalent units (see
# crates/preloop-cli/src/server_install.rs). Keep in sync.
Description=Update the Preloop binary from GitHub Releases
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/preloop update
Environment=PRELOOP_HOME=/var/lib/preloop
EnvironmentFile=-/etc/preloop/environment
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/usr/local/bin
